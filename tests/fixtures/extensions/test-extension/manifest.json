{
  "manifest_version": 3,
  "name": "Núcleo Test Extension",
  "version": "1.0.0",
  "description": "Extensão determinística de teste para o Núcleo Browser",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Núcleo Test Action"
  },
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*/*", "<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
