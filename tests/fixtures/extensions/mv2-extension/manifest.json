{
  "manifest_version": 2,
  "name": "Núcleo MV2 Test Extension",
  "version": "2.0.0",
  "description": "Extensão Manifest V2 para validação e compatibilidade",
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "MV2 Action"
  },
  "permissions": [
    "tabs",
    "https://*.example.com/*"
  ],
  "background": {
    "scripts": ["background.js"]
  }
}
